defmodule WordCount do
  @doc """
  Count the number of words in the sentence.

  Words are compared case-insensitively.
  """
  @spec count(String.t()) :: map
  def count(sentence) do
    sentence
    |> String.downcase()
    |> then(&Regex.scan(~r/[[:alnum:]]+(?:'[[:alnum:]]+)*/, &1))
    |> List.flatten()
    |> Enum.frequencies()
  end
end
